{%- liquid
  if section.settings.world_1_link != blank
    assign world_1_url = section.settings.world_1_link
  else
    assign world_1_url = collections[section.settings.world_1_collection].url | default: routes.all_products_collection_url
  endif
  if section.settings.world_2_link != blank
    assign world_2_url = section.settings.world_2_link
  else
    assign world_2_url = collections[section.settings.world_2_collection].url | default: routes.all_products_collection_url
  endif
-%}
<section class="sec-dark" id="worlds">
  <div class="container">
    <div class="sec-head">
      <div>
        <div class="rv-up">
          <div class="eyebrow">
            <span class="eyebrow__index">{{ section.settings.index }}</span>
            <span class="eyebrow__rule"></span>
            <span class="eyebrow__label">{{ section.settings.eyebrow }}</span>
          </div>
        </div>
        <h2 class="display display-lg" style="margin-top: 1.75rem;">
          <span class="rv-mask"><span class="rv-mask-inner">{{ section.settings.heading_1 }}</span></span>
          <span class="rv-mask" style="transition-delay: 120ms;"><span class="rv-mask-inner"><em>{{ section.settings.heading_2 }}</em></span></span>
        </h2>
      </div>
      <div class="rv-up" style="transition-delay: 250ms;">
        <p class="copy" style="max-width: 19rem;">{{ section.settings.intro }}</p>
      </div>
    </div>

    <div class="worlds-grid">
      <div class="rv-up world-panel--wide" style="transition-delay: 100ms;">
        <a class="world-panel" href="{{ world_1_url }}" aria-label="{{ section.settings.world_1_cta }} — {{ section.settings.world_1_title }}">
          <span class="world-panel__media">
            {%- if section.settings.world_1_image != blank -%}
              <img src="{{ section.settings.world_1_image | image_url: width: 1200 }}" alt="{{ section.settings.world_1_image.alt | default: section.settings.world_1_title | escape }}" loading="lazy" decoding="async">
            {%- else -%}
              <img src="{{ section.settings.world_1_fallback_url }}" alt="{{ section.settings.world_1_title | escape }}" loading="lazy" decoding="async">
            {%- endif -%}
            <span class="world-panel__index">{{ section.settings.world_1_index }}</span>
            <span class="world-panel__body">
              <span class="world-panel__title">{{ section.settings.world_1_title }}</span>
              <span class="world-panel__copy" style="display: block;">{{ section.settings.world_1_copy }}</span>
              <span class="world-panel__cta">
                {{ section.settings.world_1_cta }}
                {%- render 'icons', name: 'arrow-right', class: 'icon icon--sm' -%}
              </span>
            </span>
          </span>
        </a>
      </div>

      <div class="rv-up world-panel--narrow" style="transition-delay: 250ms;">
        <a class="world-panel" href="{{ world_2_url }}" aria-label="{{ section.settings.world_2_cta }} — {{ section.settings.world_2_title }}">
          <span class="world-panel__media">
            {%- if section.settings.world_2_image != blank -%}
              <img src="{{ section.settings.world_2_image | image_url: width: 1200 }}" alt="{{ section.settings.world_2_image.alt | default: section.settings.world_2_title | escape }}" loading="lazy" decoding="async">
            {%- else -%}
              <img src="{{ section.settings.world_2_fallback_url }}" alt="{{ section.settings.world_2_title | escape }}" loading="lazy" decoding="async">
            {%- endif -%}
            <span class="world-panel__index">{{ section.settings.world_2_index }}</span>
            <span class="world-panel__body">
              <span class="world-panel__title">{{ section.settings.world_2_title }}</span>
              <span class="world-panel__copy" style="display: block;">{{ section.settings.world_2_copy }}</span>
              <span class="world-panel__cta">
                {{ section.settings.world_2_cta }}
                {%- render 'icons', name: 'arrow-right', class: 'icon icon--sm' -%}
              </span>
            </span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Two Worlds",
  "settings": [
    { "type": "text", "id": "index", "label": "Index", "default": "02" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Two Worlds" },
    { "type": "text", "id": "heading_1", "label": "Heading line 1", "default": "Two temperaments." },
    { "type": "text", "id": "heading_2", "label": "Heading line 2 (italic)", "default": "One standard of care." },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Choose a world below — or keep both close. Most households we know belong to neither entirely."
    },
    { "type": "header", "content": "World one — Dogs" },
    { "type": "text", "id": "world_1_index", "label": "Index label", "default": "N° 01 — Canis" },
    { "type": "text", "id": "world_1_title", "label": "Title", "default": "DOGS" },
    {
      "type": "textarea",
      "id": "world_1_copy",
      "label": "Copy",
      "default": "Loyal, loud, always first to the door. Goods for walk rituals, deep sleeps and the space between."
    },
    { "type": "text", "id": "world_1_cta", "label": "CTA label", "default": "Shop Dogs" },
    { "type": "collection", "id": "world_1_collection", "label": "Collection", "info": "Used when no custom link is set." },
    { "type": "url", "id": "world_1_link", "label": "Custom link", "info": "Overrides the collection link." },
    { "type": "image_picker", "id": "world_1_image", "label": "Image" },
    { "type": "url", "id": "world_1_fallback_url", "label": "Fallback image URL" },
    { "type": "header", "content": "World two — Cats" },
    { "type": "text", "id": "world_2_index", "label": "Index label", "default": "N° 02 — Felis" },
    { "type": "text", "id": "world_2_title", "label": "Title", "default": "CATS" },
    {
      "type": "textarea",
      "id": "world_2_copy",
      "label": "Copy",
      "default": "Quiet, exacting, endlessly opinionated. Goods for sunlit perches and slow, considered afternoons."
    },
    { "type": "text", "id": "world_2_cta", "label": "CTA label", "default": "Shop Cats" },
    { "type": "collection", "id": "world_2_collection", "label": "Collection", "info": "Used when no custom link is set." },
    { "type": "url", "id": "world_2_link", "label": "Custom link", "info": "Overrides the collection link." },
    { "type": "image_picker", "id": "world_2_image", "label": "Image" },
    { "type": "url", "id": "world_2_fallback_url", "label": "Fallback image URL" }
  ],
  "presets": [{ "name": "Two Worlds" }]
}
{% endschema %}
