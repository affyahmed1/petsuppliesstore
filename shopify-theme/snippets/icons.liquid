{%- comment -%} Usage: {% render 'icons', name: 'bag', class: 'icon' %} {%- endcomment -%}
{%- liquid
  assign icon_class = 'icon'
  if class != blank
    assign icon_class = class
  endif
-%}
{%- case name -%}
{%- when 'bag' -%}
<svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8h12l-1.1 12H7.1L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
{%- when 'heart' -%}
<svg class="{{ icon_class }}" data-heart-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.2C7.2 16.4 3.6 13.2 3.6 9.4c0-2.9 2.2-4.9 4.5-4.9 1.7 0 3.2 1 3.9 2.4.7-1.4 2.2-2.4 3.9-2.4 2.3 0 4.5 2 4.5 4.9 0 3.8-3.6 7-8.4 10.8Z"/></svg>
{%- when 'search' -%}
<svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16.2 16.2 4.3 4.3"/></svg>
{%- when 'close' -%}
