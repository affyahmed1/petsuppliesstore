{%- comment -%}
  Usage: {% render 'price', product: product, variant: variant, class: 'p-card__price' %}
  Renders price + optional compare-at price.
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare = target.compare_at_price
-%}
<span class="{{ class | default: 'price' }}" data-price-wrap>
  {%- if settings.show_compare_at and compare > price -%}
    <s>{{ compare | money }}</s>
  {%- endif -%}
  <span data-price>{{ price | money }}</span>
</span>
